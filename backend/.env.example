# Copy this to .env and adjust for your environment.

NODE_ENV=development

# Local Postgres by default: both URLs are the same.
# On Supabase (Project > Connect > ORMs > Prisma):
#   DATABASE_URL = transaction pooler, port 6543, ending in ?pgbouncer=true
#   DIRECT_URL   = session pooler, port 5432 (used by migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/syncnova?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/syncnova?schema=public

# Use a long, random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me

PORT=4000

# "*" allows any origin. For a real deploy where the frontend is on a different
# origin than this API, set this to that origin instead (comma-separate for more than one).
CORS_ORIGIN=*

# Only used when NODE_ENV=production. Path (relative to this backend folder) to the
# built frontend (frontend/dist after `npm run build` there). If it exists, this
# server serves it directly, so the whole app runs as one process on one port.
FRONTEND_DIST_PATH=../frontend/dist

# Where uploaded project files are stored (relative to this backend folder, or an
# absolute path e.g. on a mounted disk in production). Each project gets its own subfolder.
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25

# Optional: store uploaded files in Supabase Storage instead of UPLOADS_DIR.
# Leave empty for local dev. Set both on hosts where the disk is wiped on restart (e.g. Render free).
# SUPABASE_URL: Project Settings > Data API > Project URL
# SUPABASE_SERVICE_KEY: Project Settings > API Keys > secret key (or legacy service_role key). Keep it private.
# The bucket must exist and be private.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=project-files
