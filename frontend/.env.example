# Copy this to .env and adjust for your environment.

# Leave empty for local dev (uses the Vite proxy below) and for a production
# deploy where the backend serves this app itself. Set it only if the frontend
# is hosted on a different origin than the API, e.g. https://api.example.com/api
VITE_API_URL=

# Dev only: where the Vite dev server proxies "/api" requests to.
DEV_API_PROXY_TARGET=http://localhost:4000
