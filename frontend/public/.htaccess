# Hostinger (Apache): send every route that is not a real file to index.html,
# so React Router can handle it. Without this, refreshing /dashboard gives a 404.
# Some Apache setups serve .svg with the wrong type, so the browser won't show it.
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html must not be cached, so users get new builds right away.
# The files in /assets have a hash in their name, so they can be cached for a long time.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
